<!--
    Echoes of Eolis (https://github.com/kaimitai/faxedit)
    Advanced configuration examples

    Rename this file to:

        eoe_config_override.xml

    and edit the settings you need.

    Any entries omitted from this file will fall back to the defaults in eoe_config.xml.
-->
<eoe_config>

	<!-- region definition overrides -->
	<regions>
	</regions>

	<!-- pointer overrides -->
	<pointers>
	</pointers>

	<!-- constant overrides -->
	<consts>
		<!-- how many interrupts to wait before drawing the next tile during tilemap changes (max 34) -->
		<const name="hack_tm_change_wait_frames" value="4" />
		<!-- which sound effect to play when placing a tile - $ff for none -->
		<const name="hack_tm_change_sound_effect" value="$17" />

		<!-- bank for tilemap change subsystem -->
		<const name="hack_tm_change_bank" region="en-transl,512" value="30" />
		<const name="hack_tm_change_bank" value="9" />

		<!-- cpu address in that bank for the tilemap change subsystem -->
		<const name="hack_tm_change_cpu_addr" region="en-transl,512" value="$8000" />
		<const name="hack_tm_change_cpu_addr" value="$a000" />
	</consts>

	<!-- value set overrides -->
	<sets>
	</sets>

	<!-- boolean overrides -->
	<bools>
	</bools>

	<!-- byte map overrides -->
	<byte_to_string_maps>

		<byte_to_string_map name="command_byte_labels">
			<entry byte="$00" str="Final Spring Opening" />
			<entry byte="$01" str="Boss Room" />
			<entry byte="$02" str="End-Game Room" />
			<entry byte="$03" str="Tilemap Changes" />
		</byte_to_string_map>

		<byte_to_string_map name="iscript_opcodes">
			<!--
					Built-in runtime library.

					Remove opcodes you do not need, or add additional Impl entries.
					Impl entries must appear after all non-Impl entries. If the opcode
					numbers have gaps, the map becomes dense when loaded.
					
					Important: Vanilla opcodes occupy bytes 0-23! Use bytes 24 and up!
					
					The entries below are examples rather than a recommended or required set.
			-->
			<entry byte="24" str="Impl=IfSelectedFlag" />
			<entry byte="25" str="Impl=SetSelectedFlag" />
			<entry byte="26" str="Impl=IfWorld" />
			<entry byte="27" str="Impl=IfScreen" />
			<entry byte="28" str="Impl=IfDoorYX" />
			<entry byte="29" str="Impl=JSR" />
			<entry byte="30" str="Impl=Return" />
			<entry byte="31" str="Impl=ForceDoor" />
			<entry byte="32" str="Impl=SelectFlag" />
			<entry byte="33" str="Impl=SetFlag" />
			<entry byte="34" str="Impl=SetQuestFlag" />
			<entry byte="35" str="Impl=GetXP" />
			<entry byte="36" str="Impl=IfYX" />
			<entry byte="37" str="Impl=IfFlag" />
			<entry byte="38" str="Impl=RunScreenHandler" />
			<entry byte="39" str="Impl=Die" />
		</byte_to_string_map>

	</byte_to_string_maps>

	<!-- string overrides -->
	<strings>
		<!--
					General hacks to inject when patching ROM.
					Specify one hack per line, optionally followed by key=value parameters.
					Comma-separated entries in the value attribute are also supported for compatibility.
					These entries are examples rather than a recommended or required set.
			-->
		<string name="general_hacks">
			KillSwitch
			SameWorldTransPal2Mus
			FlexibleItems price=250
			FastStart
			BossLockedItems enemies=false
		</string>
	</strings>

	<!-- string map overrides -->
	<string_to_string_maps>
	</string_to_string_maps>

</eoe_config>
